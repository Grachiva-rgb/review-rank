{
  "name": "review-rank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.6.2 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "NODE_ENV=development next dev --port 3000",
    "build": "next build",
    "verify:build": "node scripts/verify-build.cjs",
