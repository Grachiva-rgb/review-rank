    "@capacitor/ios": "8.5.3",
    "next": "^15.5.28",
    "posthog-js": "^1.372.9",
    "posthog-node": "^5.33.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.3",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
