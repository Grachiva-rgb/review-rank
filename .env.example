# -----------------------------------------------
# ReviewRank — Environment Variables
# -----------------------------------------------
# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# -----------------------------------------------
# Required — Google Places API
# -----------------------------------------------
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create a new API key
# 3. Enable: "Places API" under APIs & Services > Library
# 4. (Recommended) Restrict the key to your server's IP or domain
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------
# Required — Site URL (used for Stripe callbacks and OG metadata)
# -----------------------------------------------
# No trailing slash. Must match the deployed domain exactly.
NEXT_PUBLIC_SITE_URL=https://reviewrank.app

# -----------------------------------------------
# Required — Admin Access
# -----------------------------------------------
# Protects /admin/* routes via HTTP Basic Auth.
# Choose a long random string (e.g. openssl rand -hex 32).
ADMIN_SECRET=

# -----------------------------------------------
# Supabase (required for leads, partners, report requests)
# -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------
# Stripe (required for partner subscription checkout)
# -----------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------
# Resend (required for lead delivery emails to partners)
# -----------------------------------------------
RESEND_API_KEY=re_...
# The "from" address for emails sent to partners (must be a verified Resend sender)
RESEND_FROM_ADDRESS=leads@reviewrank.app

# -----------------------------------------------
# PostHog Analytics (optional — client-side only)
# -----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------
# Tripadvisor Content API (optional — enables multi-source scoring for
# restaurants, hotels, attractions, and resorts)
# -----------------------------------------------
# 1. Apply for access: https://developer-tripadvisor.com/content-api/
# 2. Paste your key below. This is SERVER-SIDE ONLY — never use NEXT_PUBLIC_.
# 3. Run the Supabase migration: supabase/migrations/001_tripadvisor_integration.sql
# 4. Trigger ingestion: POST /api/admin/ingest-tripadvisor
#    Authorization: Bearer <ADMIN_SECRET>
#    Body: {} (refreshes all stale records) or {"placeId": "ChIJ..."}
TRIPADVISOR_API_KEY=

# -----------------------------------------------
# Required in production — Vercel Cron Secret
# -----------------------------------------------
# You MUST create this yourself in the Vercel dashboard. Vercel does not set it
# for you; it only *reads* it, sending the value as an "Authorization: Bearer
# <CRON_SECRET>" header when it invokes a cron job. Without it Vercel sends no
# auth header, /api/admin/ingest-tripadvisor returns 401, and the weekly
# Tripadvisor refresh silently never runs.
# Use at least 16 random characters, e.g. openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------
# Operator alerts (strongly recommended)
# -----------------------------------------------
# Money events (report requests, unmatched leads, failed lead deliveries)
# email this address via Resend. Without it those events are only visible
# by manually polling the admin pages / function logs.
OPERATOR_ALERT_EMAIL=

# Cloudflare Web Analytics beacon (optional) — token from
# dash.cloudflare.com -> Web Analytics -> Add a site
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Stripe customer portal login link (optional) — enable the no-code customer
# portal in the Stripe dashboard and paste its login URL here; it is included
# in partner welcome emails so partners can self-manage billing/cancellation.
PARTNER_PORTAL_URL=
